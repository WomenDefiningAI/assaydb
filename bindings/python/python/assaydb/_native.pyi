class AssayError(Exception):
    hint: str
class SQLError(AssayError): ...
class UnsupportedError(AssayError): ...
class ResourceError(AssayError): ...
class InternalError(AssayError): ...
class ConnectionClosedError(AssayError): ...
class NativeConnection:
    def __init__(self, directory: str, workers: int, memory_bytes: int,
                 catalog_bytes: int, max_result_bytes: int, allow_local_files: bool) -> None: ...
    def execute(self, sql: str) -> tuple[bytes | None, int]: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...
